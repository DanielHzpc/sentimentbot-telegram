# Token opcional. Si está vacío, solo usas el frontend web.
TELEGRAM_BOT_TOKEN=

# Base de datos local SQLite. Para demostración en Render funciona,
# pero el historial puede reiniciarse si el servicio se redepliega.
DATABASE_NAME=sentimentbot.db
HISTORY_LIMIT=10
MIN_TEXT_LENGTH=3

# Para Render se recomienda modo liviano sin Transformers.
USE_AI_SENTIMENT=false
ANALYSIS_MODE=rules_only
PRELOAD_AI_MODEL=false
AI_MODEL_NAME=finiteautomata/beto-sentiment-analysis
TORCH_NUM_THREADS=2

# Análisis de emociones por cámara sin DeepFace/TensorFlow.
FACE_ANALYSIS_MODE=opencv_multi_face
